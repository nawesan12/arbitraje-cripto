# =============================================================
# OmniArbitraje-AR — Configuración
# Copiar a .env y completar valores. NUNCA commitear .env.
# =============================================================

# === Modo de operación ===
# DRY_RUN=true simula trades sin ejecutar. NUNCA poner false sin entender el riesgo.
DRY_RUN=true
MIN_NET_PROFIT_PCT=1.5
TRADE_SIZE_USD=50
SCAN_INTERVAL_MS=15000
COOLDOWN_PER_PAIR_MS=300000

# === Pares y exchanges ===
# Solo USDT/ARS (alcance MVP confirmado por el usuario)
SYMBOLS=USDT/ARS
ENABLED_EXCHANGES=binance,bybit,okx,bitso,fiwind,satoshitango,belo

# === Arbitraje triangular (intra-exchange, sin transferencias) ===
TRIANGULAR_ENABLED=true
TRIANGULAR_FIAT=ARS
TRIANGULAR_VIA=USDT
TRIANGULAR_INTERMEDIATES=BTC,USDC,ETH

# === Redes on-chain ===
DEFAULT_NETWORK=TRC20
ALLOW_ERC20=false

# === Whitelist de addresses (CRÍTICO si DRY_RUN=false) ===
# Sin whitelist completa, el RiskGuard rechaza cualquier withdraw.
ADDR_BINANCE_USDT_TRC20=
ADDR_BYBIT_USDT_TRC20=
ADDR_OKX_USDT_TRC20=
ADDR_BITSO_USDT_TRC20=
ADDR_FIWIND_USDT_TRC20=
ADDR_SATOSHITANGO_USDT_TRC20=
ADDR_BELO_USDT_TRC20=

# === Exchange API keys ===
# Vacío = adapter deshabilitado para ese exchange.
# --- Globales (ccxt) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- Locales AR (REST nativo / sin API trade) ---
BITSO_API_KEY=
BITSO_API_SECRET=

FIWIND_API_KEY=
FIWIND_API_SECRET=

SATOSHITANGO_API_KEY=
SATOSHITANGO_API_SECRET=

BELO_API_KEY=
BELO_API_SECRET=

# === CriptoYa (público, sin keys) ===
CRIPTOYA_VOLUME=0.1

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLE_COMMANDS=true

# === Infra ===
REDIS_URL=redis://redis:6379
POSTGRES_URL=postgres://omni:omni@postgres:5432/omniarb

# === Fees defaults ===
DEFAULT_TAKER_FEE_PCT=0.1
DEFAULT_ONCHAIN_FEE_USD=1.5
BANK_SPREAD_PCT=0.5

# === Logging ===
LOG_LEVEL=info
LOG_FILE=./logs/omniarb.log
